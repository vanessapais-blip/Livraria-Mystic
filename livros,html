<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mystic - Livros</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #242424;
            color: #eeeeee;
            font-family: Arial, sans-serif;
        }

        header {
            height: 75px;
            background: #303030;
            border-bottom: 1px solid #444444;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 40px;
        }

        .logo {
            font-size: 28px;
            font-weight: 500;
        }

        nav {
            display: flex;
            gap: 25px;
            flex-wrap: wrap;
        }

        nav a {
            color: #bbbbbb;
            text-decoration: none;
        }

        nav a:hover {
            color: white;
        }

        main {
            max-width: 1100px;
            margin: auto;
            padding: 50px 25px;
        }

        .titulo-principal {
            font-size: 36px;
            margin-bottom: 10px;
        }

        .descricao {
            color: #999999;
            font-size: 17px;
            margin-bottom: 35px;
        }

        .pesquisa {
            width: 100%;
            padding: 15px;

            background: #303030;
            color: white;

            border: 1px solid #444444;
            border-radius: 9px;

            font-size: 15px;

            margin-bottom: 35px;
        }

        .pesquisa:focus {
            outline: none;
            border-color: #777777;
        }

        .categorias {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;

            margin-bottom: 40px;
        }

        .categoria {
            background: #303030;
            color: #bbbbbb;

            border: 1px solid #444444;
            border-radius: 20px;

            padding: 9px 16px;

            cursor: pointer;
        }

        .categoria:hover {
            background: #3b3b3b;
            color: white;
        }

        .titulo {
            font-size: 24px;
            margin-bottom: 20px;
        }

        .livros {
            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(190px, 1fr));

            gap: 25px;
        }

        .livro {
            background: #303030;

            border: 1px solid #404040;
            border-radius: 12px;

            padding: 15px;

            transition: 0.2s;
        }

        .livro:hover {
            transform: translateY(-4px);
            border-color: #666666;
        }

        .capa {
            height: 250px;

            background: #3b3b3b;

            border-radius: 8px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 60px;

            margin-bottom: 15px;
        }

        .livro h3 {
            margin-bottom: 7px;
        }

        .autor {
            color: #999999;
            font-size: 14px;
        }

        .categoria-livro {
            color: #777777;
            font-size: 13px;

            margin-top: 7px;
        }

        .botao {
            display: block;

            margin-top: 15px;
            padding: 10px;

            background: #eeeeee;
            color: #222222;

            text-align: center;

            border-radius: 7px;

            text-decoration: none;
        }

        .botao:hover {
            background: #cccccc;
        }

        footer {
            text-align: center;
            padding: 40px;
            color: #777777;
        }
    </style>
</head>


<body>

    <header>

        <div class="logo">
            Mystic
        </div>

        <nav>

            <a href="home.html">
                Início
