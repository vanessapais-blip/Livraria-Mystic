                </h3>

                <p class="autor">
                    Novo autor
                </p>

                <p class="categoria-livro">
                    Aventura
                </p>

                <a
                    href="#"
                    class="botao"
                >
                    Em breve
                </a>

            </article>


            <article class="livro">

                <div class="capa">
                    📙
                </div>

                <h3>
                    Em breve
                </h3>

                <p class="autor">
                    Novo autor
                </p>

                <p class="categoria-livro">
                    Mistério
                </p>

                <a
                    href="#"
                    class="botao"
                >
